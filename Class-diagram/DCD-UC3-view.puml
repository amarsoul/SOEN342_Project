@startuml DCD-UC3-view
hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontStyle bold
skinparam ArrowFontSize 11
skinparam nodesep 60
skinparam ranksep 70
title Partial Design Class Diagram - UC3 Issue Referral view (subset of the integrated diagram)

class Console {
  - patients : Patients
  - appointments : Appointments
  - serviceTypes : ServiceTypes
  - timeSlots : TimeSlots
  - professionals : HealthcareProfessionals
  - specialties : MedicalSpecialties
  - medications : Medications
  - referrals : Referrals
  - activityLog : ActivityLog
  - currentUser : UserAccount [0..1]
  - currentAppointment : Appointment [0..1]
  - currentConsultation : Consultation [0..1]
  - currentReferral : Referral [0..1]
  --
  + startReferral(patientId : PatientID) : String
  + setRequestedSpecialty(specialtyId : String) : HealthcareProfessional [*]
  + setRequestedProfessional(professionalId : String) : Boolean
  + enterReferralDetails(clinicalReason : String, priority : Priority)
  + submitReferral() : String
}
class ActivityLog {
  --
  + record(u : UserAccount, action : String, recordType : String)
  + record(u : UserAccount, action : String, recordType : String, p : Patient)
}
class Patients {
  --
  + find(patientId : PatientID) : Patient
}
class Referrals {
  --
  + makeReferral(p : Patient, hp : HealthcareProfessional) : Referral
  + nextReferralNumber() : String
}
class HealthcareProfessionals {
  --
  + find(licenceNumber : String) : HealthcareProfessional
}
class MedicalSpecialties {
  --
  + find(code : String) : MedicalSpecialty
}
class ActivityLogEntry {
  - timestamp : DateTime
  - action : String
  - recordType : String
  --
  + <<create>> ActivityLogEntry(timestamp : DateTime, action : String, recordType : String, u : UserAccount)
  + <<create>> ActivityLogEntry(timestamp : DateTime, action : String, recordType : String, u : UserAccount, p : Patient)
}
class Patient {
  - patientId : PatientID
  - dateOfBirth : Date
  - address : Address
  --
  + getSummary() : String
  + addReferral(r : Referral)
}
class Referral {
  - referralNumber : String
  - dateIssued : Date
  - clinicalReason : String
  - priority : Priority
  - status : ReferralStatus
  --
  + <<create>> Referral(p : Patient, hp : HealthcareProfessional)
  + setStatus(s : ReferralStatus)
  + setRequestedSpecialty(ms : MedicalSpecialty)
  + setRequestedProfessional(hp : HealthcareProfessional)
  + setClinicalReason(reason : String)
  + setPriority(priority : Priority)
  + isComplete() : Boolean
  + submit(n : String)
  + getPatient() : Patient
  - setDateIssued(d : Date)
  - setReferralNumber(n : String)
}
class HealthcareProfessional {
  - licenceNumber : String
  - profession : String
  --
  + practisesAtClinic() : Boolean
}
class MedicalSpecialty {
  - code : String
  - name : String
  --
  + getClinicProfessionals() : HealthcareProfessional [*]
}
class UserAccount {
  - username : String
  - role : Role
  --
  + canIssueReferrals() : Boolean
  + getProfessional() : HealthcareProfessional [0..1]
}
abstract class Person {
  # firstName : String
  # lastName : String
  # phone : PhoneNumber
  --
}
class ClinicLocation {
  - name : String
  - address : Address
  --
}
Console "1" --> "1\nactivityLog" ActivityLog
Console "1" --> "1\npatients" Patients
Console "1" --> "1\nreferrals" Referrals
Console "1" --> "1\nprofessionals" HealthcareProfessionals
Console "1" --> "1\nspecialties" MedicalSpecialties
ActivityLog "1" *--> "*\nentries" ActivityLogEntry
Patients "1" o--> "*\npatients" Patient
Referrals "1" *--> "*\nreferrals" Referral
HealthcareProfessionals "1" o--> "*\nprofessionals" HealthcareProfessional
MedicalSpecialties "1" o--> "*\nspecialties" MedicalSpecialty
ActivityLogEntry "*" --> "1\nperformedBy" UserAccount : Performed-by
UserAccount "0..1" --> "1\nperson" Person : Identifies
HealthcareProfessional "*" --> "0..*\nlocations" ClinicLocation : Practises-at
Referral "*" --> "0..1\nrequestedSpecialty" MedicalSpecialty : Requests-specialty
Console -[norank]-> "0..1\ncurrentUser" UserAccount
Console -[norank]-> "0..1\ncurrentReferral" Referral
Person <|-[norank]- Patient
Person <|-[norank]- HealthcareProfessional
ActivityLogEntry "*" -[norank]-> "0..1\npatient" Patient : Concerns
MedicalSpecialty "0..*" -[norank]-> "*\nprofessionals" HealthcareProfessional : Specializes-in
Referral "*\nreferrals" <-[norank]-> "1\npatient" Patient : Concerns
Referral "*" -[norank]-> "1\nissuedBy" HealthcareProfessional : Issued-by
Referral "*" -[norank]-> "0..1\nrequestedProfessional" HealthcareProfessional : Requests-professional
Console .[norank].> Patient
Console .[norank].> HealthcareProfessional
Console .[norank].> MedicalSpecialty
Referrals .[norank].> Patient
@enduml
