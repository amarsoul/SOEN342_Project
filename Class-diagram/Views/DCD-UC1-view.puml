@startuml DCD-UC1-view
hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontStyle bold
skinparam ArrowFontSize 11
skinparam nodesep 60
skinparam ranksep 70
title Partial Design Class Diagram - UC1 Book Appointment view (subset of the integrated diagram)

class Console {
  - patients : Patients
  - appointments : Appointments
  - serviceTypes : ServiceTypes
  - timeSlots : TimeSlots
  - professionals : HealthcareProfessionals
  - specialties : MedicalSpecialties
  - medications : Medications
  - referrals : Referrals
  - activityLog : ActivityLog
  - currentUser : UserAccount [0..1]
  - currentAppointment : Appointment [0..1]
  - currentConsultation : Consultation [0..1]
  - currentReferral : Referral [0..1]
  --
  + searchPatients(criteria : SearchCriteria) : Patient [*]
  + startNewBooking(patientId : PatientID) : String
  + specifyService(serviceTypeId : String, fromDate : Date, toDate : Date) : TimeSlot [*]
  + selectTimeSlot(slotId : String) : String
  + confirmAppointment() : String
}
class ActivityLog {
  --
  + record(u : UserAccount, action : String, recordType : String)
  + record(u : UserAccount, action : String, recordType : String, p : Patient)
}
class Patients {
  --
  + search(criteria : SearchCriteria) : Patient [*]
  + find(patientId : PatientID) : Patient
}
class Appointments {
  --
  + makeAppointment(p : Patient, u : UserAccount) : Appointment
  + nextAppointmentNumber() : String
}
class TimeSlots {
  --
  + find(slotId : String) : TimeSlot
}
class ServiceTypes {
  --
  + find(serviceTypeId : String) : ServiceType
}
class ActivityLogEntry {
  - timestamp : DateTime
  - action : String
  - recordType : String
  --
  + <<create>> ActivityLogEntry(timestamp : DateTime, action : String, recordType : String, u : UserAccount)
  + <<create>> ActivityLogEntry(timestamp : DateTime, action : String, recordType : String, u : UserAccount, p : Patient)
}
class Patient {
  - patientId : PatientID
  - dateOfBirth : Date
  - address : Address
  --
  + getSummary() : String
  + findValidReferral(ms : MedicalSpecialty, hp : HealthcareProfessional) : Referral [0..1]
}
class Appointment {
  - appointmentNumber : String [0..1]
  - date : Date [0..1]
  - startTime : Time [0..1]
  - status : AppointmentStatus
  - arrivalTime : Time [0..1]
  - preferredTimeFrame : String
  --
  + <<create>> Appointment(p : Patient, u : UserAccount)
  + setStatus(s : AppointmentStatus)
  + setServiceType(st : ServiceType)
  + setPreferredTimeFrame(fromDate : Date, toDate : Date)
  + setPreferredTimeFrame(timeFrame : String)
  + selectSlot(ts : TimeSlot) : Boolean
  + confirm(n : String)
  + getPatient() : Patient
  - clearSelection()
  - setTimeSlot(ts : TimeSlot)
  - setProfessional(hp : HealthcareProfessional)
  - setDate(d : Date)
  - setStartTime(t : Time)
  - setReferral(r : Referral)
  - addResource(R : Resource)
  - setAppointmentNumber(n : String)
}
class Referral {
  - referralNumber : String
  - dateIssued : Date
  - clinicalReason : String
  - priority : Priority
  - status : ReferralStatus
  --
  + <<create>> Referral(p : Patient, hp : HealthcareProfessional)
  + setStatus(s : ReferralStatus)
  + addAppointment(a : Appointment)
  + removeAppointment(a : Appointment)
}
class TimeSlot {
  - slotId : String
  - date : Date
  - startTime : Time
  - endTime : Time
  - isAvailable : Boolean
  --
  + isBookable(st : ServiceType, a : Appointment) : Boolean
  + getProfessional() : HealthcareProfessional
  + getDate() : Date
  + getStartTime() : Time
  + setAvailable(b : Boolean)
  + setOccupant(a : Appointment [0..1])
  + getOffer() : WaitingListEntry [0..1]
  + clearOffer()
}
class ServiceType {
  - serviceTypeId : String
  - name : String
  - durationMinutes : Integer
  - requiresReferral : Boolean
  --
  + getProviders() : HealthcareProfessional [*]
  + getRequirements() : ResourceRequirement [*]
  + getSpecialty() : MedicalSpecialty [0..1]
  + getDurationMinutes() : Integer
  + requiresReferral() : Boolean
}
class HealthcareProfessional {
  - licenceNumber : String
  - profession : String
  --
  + getBookableSlots(fromDate : Date, toDate : Date, st : ServiceType, a : Appointment) : TimeSlot [*]
  + provides(st : ServiceType) : Boolean
}
class MedicalSpecialty {
  - code : String
  - name : String
  --
}
class UserAccount {
  - username : String
  - role : Role
  --
}
class WaitingListEntry {
  - dateRequested : DateTime
  - reason : String
  - priority : Priority
  - status : WaitlistStatus
  --
  + concerns(p : Patient) : Boolean
  + accept(a : Appointment)
  - setOfferedSlot(ts : TimeSlot [0..1])
  - setAppointment(a : Appointment)
  - setStatus(s : WaitlistStatus)
}
class ResourceRequirement {
  - quantityNeeded : Integer
  --
  + getResource() : Resource
  + getQuantityNeeded() : Integer
}
class Resource {
  - name : String
  - type : ResourceType
  - quantity : Integer
  --
  + hasCapacity(ts : TimeSlot, q : Integer, a : Appointment) : Boolean
  + allocate(a : Appointment)
  + deallocate(a : Appointment)
  - quantityInUse(ts : TimeSlot, a : Appointment) : Integer
}
Console "1" --> "1\nactivityLog" ActivityLog
Console "1" --> "1\npatients" Patients
Console "1" --> "1\nappointments" Appointments
Console "1" --> "1\ntimeSlots" TimeSlots
Console "1" --> "1\nserviceTypes" ServiceTypes
ActivityLog "1" *--> "*\nentries" ActivityLogEntry
Patients "1" o--> "*\npatients" Patient
Appointments "1" *--> "*\nappointments" Appointment
TimeSlots "1" o--> "*\nslots" TimeSlot
ServiceTypes "1" o--> "*\nserviceTypes" ServiceType
ActivityLogEntry "*" --> "1\nperformedBy" UserAccount : Performed-by
Appointment "0..1\noccupant" <--> "0..1\ntimeSlot" TimeSlot : Occupies
Appointment "*" --> "1\nserviceType" ServiceType : Is-for
Appointment "*" --> "0..1\nprofessional" HealthcareProfessional : Scheduled-with
TimeSlot "0..1\nofferedSlot" <--> "0..1\noffer" WaitingListEntry : Is-offered
ServiceType "1" *--> "*\nrequirements" ResourceRequirement : Requires
ResourceRequirement "*" --> "1\nresource" Resource
Console -[norank]-> "0..1\ncurrentUser" UserAccount
Console -[norank]-> "0..1\ncurrentAppointment" Appointment
ActivityLogEntry "*" -[norank]-> "0..1\npatient" Patient : Concerns
HealthcareProfessional "1\nprofessional" <-[norank]-> "*\nslots" TimeSlot : Available-during
HealthcareProfessional "*\nproviders" <-[norank]-> "*\nservices" ServiceType : Provides
Appointment "*" -[norank]-> "1\npatient" Patient : Booked-for
Appointment "*" -[norank]-> "1\nbookedBy" UserAccount : Booked-by
Appointment "*\nallocatedTo" <-[norank]-> "*\nresources" Resource : Is-allocated
ServiceType "*" -[norank]-> "0..1\nspecialty" MedicalSpecialty : Belongs-to
WaitingListEntry "*" -[norank]-> "1\npatient" Patient : Concerns
WaitingListEntry "0..1" -[norank]-> "0..1\nappointment" Appointment : Results-in
Referral "*\nreferrals" <-[norank]-> "1\npatient" Patient : Concerns
Referral "0..1\nreferral" <-[norank]-> "*\nappointments" Appointment : Results-in
Console .[norank].> Patient
Console .[norank].> HealthcareProfessional
Console .[norank].> ServiceType
TimeSlot .[norank].> ServiceType
TimeSlot .[norank].> ResourceRequirement
TimeSlot .[norank].> Resource
Appointment .[norank].> ResourceRequirement
Appointment .[norank].> WaitingListEntry
@enduml
